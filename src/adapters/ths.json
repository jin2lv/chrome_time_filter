{
  "version": "0.1.0",
  "platforms": [
    {
      "name": "同花顺",
      "domains": ["t.10jqka.com.cn"],
      "post_selectors": ["li.feed-item", ".feed-item"],
      "timestamp": {
        "selector": ".feed-item-timeline-time",
        "type": "custom",
        "format": "MMDD HH:mm",
        "attr": null,
        "date_attr": "data-date"
      },
      "comment_selectors": [],
      "comment_timestamp_selector": "",
      "quick_presets": [
        { "label": "1小时前", "value": "1_hour_ago" },
        { "label": "今日0点", "value": "today_midnight" },
        { "label": "昨日0点", "value": "yesterday_midnight" }
      ],
      "notes": "DOM 取证于 2026-08-11：首页信息流 li.feed-item（实测 36 条），日期在容器 data-date 属性（MMDD，如 0811），时间在 .feed-item-timeline-time（HH:mm）。组合为 'MMDD HH:mm'，无年份需补当年并处理跨年。评论选择器待 P2-4 取证。"
    }
  ]
}
