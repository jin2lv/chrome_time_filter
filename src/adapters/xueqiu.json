{
  "version": "0.2.0",
  "platforms": [
    {
      "name": "雪球",
      "domains": ["xueqiu.com"],
      "post_selectors": ["article.timeline__item", ".timeline__item"],
      "timestamp": {
        "selector": "a.date-and-source",
        "type": "relative",
        "strip_pattern": "^修改于",
        "patterns": [
          { "regex": "^(\\d+)分钟前", "unit": "minute", "multiplier": 1 },
          { "regex": "^(\\d+)小时前", "unit": "hour", "multiplier": 1 },
          { "regex": "^昨天", "unit": "day", "multiplier": 1 },
          { "regex": "^(\\d+)天前", "unit": "day", "multiplier": 1 }
        ],
        "attr": null
      },
      "comment_selectors": [".comment__item"],
      "comment_timestamp_selector": "span.time",
      "quick_presets": [
        { "label": "1小时前", "value": "1_hour_ago" },
        { "label": "今日0点", "value": "today_midnight" },
        { "label": "昨日0点", "value": "yesterday_midnight" }
      ],
      "virtual_pagination": {
        "list_selector": ".stock-timeline > .status-list",
        "post_id": {
          "selector": "a.date-and-source",
          "attr": "data-id"
        },
        "source_link_selector": "a.date-and-source",
        "context_selector": ".stock-timeline-tabs a.active",
        "native_pagination_selector": ".stock-timeline > .pagination",
        "next_selector": ".pagination__next",
        "active_page_selector": ".pagination a.active",
        "first_page": {
          "input_selector": ".pagination input",
          "value": "1"
        },
        "page_size": 10,
        "max_source_pages": 200,
        "wait_ms": 300
      },
      "notes": "DOM 取证于 2026-08-13：个股页全部/讨论/投资者关系/交易/资讯/公告六类共用 .stock-timeline > .status-list、article.timeline__item、a.date-and-source[data-id] 与原生分页；类别由 .stock-timeline-tabs a.active 标识，切换类别时重建独立虚拟分页会话。编辑帖格式为 '修改于MM-DD HH:mm'。虚拟分页跨原生页按需聚合，每虚拟页 10 条，单次会话最多扫描 200 个原生页。详情页评论 .comment__item，时间戳 span.time。"
    }
  ]
}
